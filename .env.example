# Vercel 프로젝트 Settings > Environment Variables에 동일한 이름으로 등록하세요.
QDRANT_URL=https://369c3c10-a6a4-469a-8deb-3acaa7995c6c.us-east-1-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=여기에_Qdrant_API_키
VOYAGE_API_KEY=여기에_Voyage_API_키

# ── 접근 게이트(선택) ────────────────────────────────────────────────
# 허용할 게이트키 목록(쉼표 구분). 비워두면 게이트가 비활성화되어 모든 요청이 통과합니다.
MCP_GATE_KEYS=plk_사람1_난수,plk_사람2_난수
# observe = 키가 없어도 통과시키되 로그만 남김(커넥터 URL 교체 기간용, 기본값)
# enforce = 키가 없거나 목록에 없으면 401로 차단
MCP_GATE_MODE=observe
